erDiagram
    patients ||--o{ lung_scans : "undergoes"
    patients ||--o{ reports : "receives"
    lung_scans ||--o{ predictions : "yields"
    predictions ||--o| reports : "documents"

    patients {
        int id PK "Auto-incrementing surrogate ID"
        string patient_id UK "Unique hospital identifier"
        string name "Patient full name"
        int age "Patient age in years"
        string gender "Biological sex (M/F/Other)"
        string contact "Telephone contact (Optional)"
        string email "Electronic mail address (Optional)"
        text medical_history "Clinical history notes (Optional)"
        datetime created_at "Registration timestamp"
        datetime updated_at "Record update timestamp"
    }

    lung_scans {
        int id PK "Auto-incrementing surrogate ID"
        string scan_id UK "UUID scan tracking token"
        int patient_id FK "References patients.id"
        string image_path "Absolute filesystem path"
        string image_filename "Original uploaded file name"
        int image_size_bytes "File size in bytes"
        string scan_type "Imaging modality (X-Ray)"
        datetime scan_date "Image acquisition timestamp"
        boolean preprocessed "Preprocessing completion flag"
        text notes "Radiological clinical notes"
    }

    predictions {
        int id PK "Auto-incrementing surrogate ID"
        string prediction_id UK "UUID diagnostic token"
        int scan_id FK "References lung_scans.id"
        string model_used "Model identifier (DenseNet)"
        string selected_model "Production model (Model D)"
        string final_condition "Predicted clinical class (6 classes)"
        float final_confidence "Primary probability score [0.0-1.0]"
        string urgency_level "Triage level (Routine/Urgent/Emerg)"
        json alternative_conditions "Ranked differential candidates"
        json key_findings "Radiological hallmark indicators"
        json precautions "Clinical management guidelines"
        datetime created_at "Inference timestamp"
    }

    reports {
        int id PK "Auto-incrementing surrogate ID"
        string report_id UK "UUID report document token"
        int prediction_id FK "References predictions.id"
        int patient_id FK "References patients.id"
        string report_type "Document format (PDF/JSON)"
        string report_title "Clinical diagnostic title"
        text summary "Comprehensive diagnostic summary"
        text clinical_recommendations "Actionable clinical triage notes"
        string report_file_path "Exported document file path"
        datetime generated_at "Report generation timestamp"
    }
