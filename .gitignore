# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
.pytest_cache/
.env
backend/.env
*.egg-info/

# Model files (large binary weights - use Git LFS or Releases)
*.h5
*.keras

# Data (large - do not commit raw images / dataset archives). data/manifests/ IS tracked.
data/raw/
data/processed/
data/downloads/
data/external/
data/derived/

# Training runs (checkpoints + run metadata); evaluation runs with per-image predictions
runs/
artifacts/evaluation_reports/*/

# Database
*.db
*.sqlite3

# Node
frontend/node_modules/
frontend/build/
frontend/.env.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# Uploads
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# Build & Coverage
dist/
build/
coverage/
.cache/
.next/
.ipynb_checkpoints/

# Temporary & Editor files
*.tmp
*.temp
*.bak
*.swp
*~

# scratch files used for doc generation
scratch/
.scratch
.scracth

# python env used for doc generation
/venv_doc_gen
# Frontend build copied next to the backend (created inside the Docker image)
backend/static/
# Per-image predictions of the run comparison (same policy as the per-split report folders)
artifacts/evaluation_reports/run_comparison_predictions.csv

# Novelty feature caches (large, regenerable with lungai.novelty.features); results JSON and access log stay tracked
artifacts/novelty/**/features_*
artifacts/novelty/*.pkl
