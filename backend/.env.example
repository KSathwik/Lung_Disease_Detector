# ── Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./lung_disease.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lung_db

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Model paths (auto-created after training)
MODELS_DIR=models/
