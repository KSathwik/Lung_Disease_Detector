# ── Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./lung_disease.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lung_db

# Set to true to log every SQL statement (noisy — disable in production)
SQL_ECHO=false

# API Settings (used by `python main.py`; 127.0.0.1 keeps the API local to this machine)
API_HOST=127.0.0.1
API_PORT=8000

# Required for any client that is not on this machine. Clients send it as the X-API-Key header
# (the frontend reads REACT_APP_API_KEY at build time). Leave empty for local-only use.
LUNGAI_API_KEY=

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Folder holding densenet121_frequency_v5.h5 and training_results.json
# (absolute, or relative to the repository root). Defaults to <repo>/models.
MODELS_DIR=models/

# Where uploaded images are stored (relative to the working directory)
UPLOADS_DIR=uploads

# Top-class probability below which a result is reported as inconclusive (not clinically validated)
CONFIDENCE_FLOOR=0.5
